# Copie este arquivo para .env e ajuste se necessário.
# Usado tanto pelo docker-compose.yml (sobe o Postgres) quanto pela app
# (monta o DATABASE_URL a partir dos mesmos valores).

POSTGRES_USER=infosiga
POSTGRES_PASSWORD=infosiga
POSTGRES_DB=infosiga
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://infosiga:infosiga@localhost:5432/infosiga

MUNICIPIO_ALVO=RIBEIRAO PRETO

# Autenticação do admin (usada para liberar POST /ingest/csv).
ADMIN_USERNAME=admin
# Gere com: python scripts/hash_password.py
ADMIN_PASSWORD_HASH=
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Origens (browser) liberadas para consumir a API, separadas por vírgula.
# Padrão cobre dev servers locais comuns (Vite/CRA); em produção, apontar
# para o domínio real do frontend.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080
